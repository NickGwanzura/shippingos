// Spiritus Shipping & Logistics Management System — Demo
// Prisma schema. All monetary fields use Prisma Decimal (decimal-safe).
// Statuses/enums are stored as String with the canonical values enforced in
// TypeScript constants (src/lib/constants.ts) for flexibility and logging.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// STAFF / USERS (RBAC)
// ============================================================

enum UserRole {
  SUPER_ADMIN
  OPERATIONS
  ACCOUNTS
  SALES
  CUSTOMER_SUPPORT
  READ_ONLY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATIONS)
  title        String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedShipments   Shipment[]     @relation("AssignedStaff")
  uploadedDocuments   Document[]
  activity            ActivityLog[]
  notifications       Notification[]
  quotesIssued        Quote[]
  paymentsReceived    Payment[]
  supportNotesCreated SupportNote[]

  @@index([email])
}

// ============================================================
// CUSTOMERS
// ============================================================

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  FREIGHT_FORWARDER
  NGO
  GOVERNMENT
  CHURCH
  ASSOCIATION
}

model Customer {
  id            String       @id @default(cuid())
  fullName      String
  businessName  String?
  phone         String
  whatsapp      String?
  email         String?
  address       String?
  country       String       @default("Zimbabwe")
  customerType  CustomerType @default(INDIVIDUAL)
  portalEnabled Boolean      @default(false)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  shipments    Shipment[]
  quotes       Quote[]
  invoices     Invoice[]
  payments     Payment[]
  documents    Document[]
  portalUser   PortalUser?
  supportNotes SupportNote[]
  activity     ActivityLog[]

  @@index([fullName])
  @@index([email])
}

// ============================================================
// CUSTOMER PORTAL
// ============================================================

model PortalUser {
  id           String    @id @default(cuid())
  customerId   String    @unique
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
}

// ============================================================
// QUOTATIONS
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  shipmentType     String
  origin           String
  destination      String
  cargoDescription String
  freightCharge    Decimal     @default(0) @db.Decimal(14, 2)
  collectionFee    Decimal     @default(0) @db.Decimal(14, 2)
  clearingFee      Decimal     @default(0) @db.Decimal(14, 2)
  insurance        Decimal     @default(0) @db.Decimal(14, 2)
  deliveryFee      Decimal     @default(0) @db.Decimal(14, 2)
  storage          Decimal     @default(0) @db.Decimal(14, 2)
  otherCharges     Decimal     @default(0) @db.Decimal(14, 2)
  discount         Decimal     @default(0) @db.Decimal(14, 2)
  total            Decimal     @db.Decimal(14, 2)
  depositRequired  Decimal     @default(0) @db.Decimal(14, 2)
  currency         String      @default("USD")
  status           QuoteStatus @default(DRAFT)
  expiryDate       DateTime?
  issuedById       String?
  issuedBy         User?       @relation(fields: [issuedById], references: [id])
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  shipment Shipment?
  isDemo   Boolean   @default(false)

  @@index([customerId])
  @@index([status])
}

// ============================================================
// SHIPMENTS
// ============================================================

model Shipment {
  id             String   @id @default(cuid())
  shipmentNumber String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  quoteId        String?  @unique
  quote          Quote?   @relation(fields: [quoteId], references: [id])

  shipmentType  String
  status        String @default("ENQUIRY")
  paymentStatus String @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID

  origin              String
  destination         String
  collectionAddress   String?
  deliveryAddress     String?
  departureDate       DateTime?
  expectedArrival     DateTime?
  actualArrival       DateTime?
  carrier             String?
  vessel              String?
  containerNumber     String?
  trackingReference   String?
  vehicleRegistration String?
  vin                 String?
  make                String?
  model               String?
  year                Int?
  weight              Decimal?  @db.Decimal(12, 2)
  volume              Decimal?  @db.Decimal(12, 2)
  notes               String?

  assignedStaffId String?
  assignedStaff   User?   @relation("AssignedStaff", fields: [assignedStaffId], references: [id])

  invoiceTotal  Decimal @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal @default(0) @db.Decimal(14, 2)
  outstanding   Decimal @default(0) @db.Decimal(14, 2)
  revenue       Decimal @default(0) @db.Decimal(14, 2) // confirmed (paid/accrued) revenue
  expensesTotal Decimal @default(0) @db.Decimal(14, 2)
  profit        Decimal @default(0) @db.Decimal(14, 2)
  profitMargin  Decimal @default(0) @db.Decimal(6, 2) // percentage

  bookedAt    DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  documents    Document[]
  activity     ActivityLog[]
  supportNotes SupportNote[]
  isDemo       Boolean       @default(false)

  @@index([customerId])
  @@index([status])
  @@index([shipmentNumber])
}

// ============================================================
// INVOICES
// ============================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  shipmentId    String
  shipment      Shipment      @relation(fields: [shipmentId], references: [id])
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime
  total         Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  balance       Decimal       @default(0) @db.Decimal(14, 2)
  currency      String        @default("USD")
  status        InvoiceStatus @default(SENT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]
  isDemo   Boolean   @default(false)

  @@index([customerId])
  @@index([shipmentId])
  @@index([status])
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ECOCASH
  CARD
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  shipmentId   String
  shipment     Shipment      @relation(fields: [shipmentId], references: [id])
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @default("USD")
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?
  date         DateTime      @default(now())
  notes        String?
  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id])
  createdAt    DateTime      @default(now())

  receiptNumber String?
  isDemo        Boolean @default(false)

  @@index([customerId])
  @@index([shipmentId])
  @@index([invoiceId])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  supplier   String?
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("USD")
  date       DateTime @default(now())
  category   String // FREIGHT | COLLECTION | PORT_CHARGES | CUSTOMS | CLEARING | TRANSPORT | FUEL | STORAGE | INSPECTION | MECHANIC | TOWING | DRIVER | ACCOMMODATION | DOCUMENTATION | OTHER
  receiptKey String? // storage key on receipts
  notes      String?
  createdAt  DateTime @default(now())

  isDemo Boolean @default(false)

  @@index([shipmentId])
}

// ============================================================
// DOCUMENTS
// ============================================================

enum DocumentType {
  BILL_OF_LADING
  INVOICE
  PACKING_LIST
  EXPORT_DOCUMENTS
  CUSTOMS_DOCUMENTS
  INSPECTION_CERTIFICATE
  VEHICLE_DOCUMENTS
  PROOF_OF_PAYMENT
  PHOTOS
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  shipmentId   String?
  shipment     Shipment?    @relation(fields: [shipmentId], references: [id])
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  fileName     String
  type         DocumentType @default(OTHER)
  sizeBytes    Int?
  mimeType     String?
  url          String
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([shipmentId])
}

// ============================================================
// SUPPORT NOTES / UPDATES
// ============================================================

model SupportNote {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])
  note        String
  isInternal  Boolean   @default(true) // internal notes hidden from customer portal
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([customerId])
  @@index([shipmentId])
}

// ============================================================
// ACTIVITY LOG
// ============================================================

enum ActivityAction {
  SHIPMENT_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  PAYMENT_RECORDED
  DOCUMENT_UPLOADED
  STATUS_UPDATED
  INVOICE_CREATED
  SHIPMENT_DELIVERED
  PORTAL_LOGIN
  CUSTOMER_CREATED
  EXPENSE_ADDED
  QUOTE_CREATED
  NOTE_ADDED
}

model ActivityLog {
  id          String         @id @default(cuid())
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id])
  action      ActivityAction
  description String
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id])
  shipmentId  String?
  shipment    Shipment?      @relation(fields: [shipmentId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([actorId])
  @@index([customerId])
  @@index([shipmentId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationChannel {
  EMAIL
  WHATSAPP
  INTERNAL
}

model Notification {
  id          String              @id @default(cuid())
  type        String // SHIPMENT_DEPARTED | ARRIVED | PAYMENT_RECEIVED | BALANCE_REMINDER | DOCUMENT_UPLOADED | DELIVERED
  channel     NotificationChannel @default(INTERNAL)
  recipient   String
  subject     String?
  body        String
  status      String              @default("PENDING")
  sentAt      DateTime?
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  @@index([channel])
}

// ============================================================
// COMPANY / TENANT SETTINGS
// ============================================================

model CompanySettings {
  id               Int      @id @default(1)
  companyName      String   @default("Horizon Freight & Logistics")
  tagline          String   @default("Moving Business Forward")
  logoUrl          String?
  primaryColor     String   @default("#0B3B8C")
  currency         String   @default("USD")
  supportPhone     String   @default("")
  supportEmail     String   @default("")
  whatsappNumber   String   @default("")
  salesWhatsapp    String   @default("")
  website          String   @default("")
  modules          String   @default("dashboard,customers,quotes,shipments,invoices,payments,expenses,documents,reports,portal")
  presentationMode Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}
