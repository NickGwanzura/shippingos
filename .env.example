# Database (PostgreSQL). Use ?schema=shipping to isolate from other apps.
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require&schema=shipping"

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Demo / Company config overrides
NEXT_PUBLIC_DEMO_MODE="true"

# Container startup: seed only when the users table is empty.
SEED_DEMO_DATA_IF_EMPTY="true"
